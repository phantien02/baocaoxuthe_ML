# LLM (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Netchat (Mattermost-compatible)
# NETCHAT_URL: domain người dùng — dùng cho WebSocket
# NETCHAT_BOT_URL: domain bot — BẮT BUỘC cho REST API khi dùng Bot Token
# (gọi nhầm netchat.viettel.vn sẽ bị 403 "API bot phải được gọi qua BMS")
NETCHAT_URL=https://netchat.viettel.vn
NETCHAT_BOT_URL=https://bot-netchat.viettel.vn
NETCHAT_TOKEN=mm_your_token_here
NETCHAT_CHANNEL_NAME=ai_bot_clm_tienpc1
# Tùy chọn: đặt sẵn channel ID để khỏi tra cứu (bot phải là thành viên channel)
#NETCHAT_CHANNEL_ID=
# Tùy chọn: WAF nội bộ chặn User-Agent python-requests; mặc định client dùng UA curl
#NETCHAT_USER_AGENT=curl/8.4.0

# Scheduler (Asia/Ho_Chi_Minh timezone)
REPORT_SCHEDULE_DAY=mon  # 0=Monday ... 6=Sunday, or mon/tue/wed/thu/fri/sat/sun
REPORT_SCHEDULE_TIME=08:00
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
# Danh sách username (ngăn cách bằng phẩy) được phép đổi lịch qua lệnh !schedule
ADMIN_USERNAMES=tienpc1

# Storage
DB_PATH=/data/agent.db
